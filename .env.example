# daily-companion 設定ファイルのテンプレート
# このファイルを .env という名前でコピーし、値を埋めてください。
# .env は .gitignore 済みなのでGitには含まれません。

# ---------------------------------------------------------------
# 通知 (ntfy.sh)
# ---------------------------------------------------------------
# トピック名は「知っている人なら誰でも購読できる」ので、
# 推測されにくいランダムな文字列にしてください。
# 例: mydiary-7f3a91c4e2
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ---------------------------------------------------------------
# Googleカレンダー (サービスアカウント方式)
# ---------------------------------------------------------------
# Google Cloudで発行したサービスアカウントのJSON鍵ファイルのパス。
# 既定では credentials/service-account.json を読むので、
# そこに置くならこの行は空のままで構いません。
GOOGLE_SERVICE_ACCOUNT_FILE=

# 対象カレンダーのID。空にすると、サービスアカウントに共有されている
# 全カレンダーを読み込みます。複数指定はカンマ区切り。
# IDはGoogleカレンダーの「設定と共有」→「カレンダーの統合」で確認できます。
GOOGLE_CALENDAR_IDS=

# ---------------------------------------------------------------
# Webアプリ
# ---------------------------------------------------------------
# 0.0.0.0 にすると同じWi-Fi内のスマホからアクセスできます。
WEB_HOST=0.0.0.0
WEB_PORT=8765

# ---------------------------------------------------------------
# ニュース要約
# ---------------------------------------------------------------
# 利用可能なジャンル:
#   ai_tech     AI・IT技術
#   job_hunting 就活・業界動向
#   social      就活の実践知・体験記（ES・面接・インターンの具体的な記録）
#   economy     経済・市場（金融政策、為替・株式、景気指標、決算）
#   domestic    国内一般ニュース
#   world       海外・国際情勢
#
# ジャンルは同時に収集されるので、増やしても所要時間はあまり伸びません。
# ただし同時実行数の上限（jobs/news_digest.py の MAX_CONCURRENT、現在4）を
# 超えると2巡目が発生し、所要時間がほぼ倍になります。
NEWS_TOPICS=ai_tech,job_hunting,social,economy

# ---------------------------------------------------------------
# Claude 実行設定
# ---------------------------------------------------------------
CLAUDE_TIMEOUT_SEC=300

# ---------------------------------------------------------------
# タイムゾーン
# ---------------------------------------------------------------
TIMEZONE=Asia/Tokyo
